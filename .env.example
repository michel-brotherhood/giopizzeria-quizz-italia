# Copie para .env (nunca versionar valores reais). Nada aqui vai para o navegador.
# Ambiente: development | test | production
APP_ENV=
# PostgreSQL (na VPS/Dokku: fornecido pelo plugin postgres como DATABASE_URL)
DATABASE_URL=
# Segredo longo e aleatório (>= 32 caracteres). Ex.: openssl rand -base64 48
SESSION_SECRET=
# URL pública com HTTPS, sem barra final (usada nos links de convite e no QR do voucher)
PUBLIC_BASE_URL=
PORT=
# Servir o build (dist/) pelo próprio Express. Em produção: true
SERVE_STATIC=
# Cookies Secure (HTTPS). Em produção: true
COOKIE_SECURE=
# Número de proxies confiáveis à frente do app (Dokku/nginx: 1)
TRUST_PROXY=
# Ativação de campanha REAL. Manter false até a oferta/operação serem aprovadas pelo restaurante.
REAL_CAMPAIGNS_ENABLED=
# Intervalo da rotina de expiração (segundos)
EXPIRY_INTERVAL_SECONDS=
# Duração da sessão da equipe (horas)
STAFF_SESSION_HOURS=
