{
  "name": "gio-da-massa-ao-forno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gio Pizzeria — Da massa ao forno: quiz gastronômico 3D com fluxo de brindes controlado pelo servidor.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server --watch-path=shared server/index.js",
    "dev:web": "vite",
    "dev:db": "node scripts/dev-db.js",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "node scripts/lint.js",
    "test": "vitest run --config vitest.config.js",
    "test:content": "vitest run --config vitest.config.js tests/unit/content.test.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:e2e": "playwright test",
    "db:migrate": "node server/db/migrate.js",
    "db:seed-test": "node scripts/seed-test.js",
    "staff:create": "node scripts/create-operator.js"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^10.0.7",
    "embedded-postgres": "^18.6.0-beta.19",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true
  }
}
